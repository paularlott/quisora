# Copy to .env (git ignores it) to point the run-server task at your machine. Each defaults to localhost.
#
# DEV_PUBLIC_URL: the address browsers and applications use (the issuer); scheme, host and port.
# DEV_LISTEN: the address and port the server listens on (0.0.0.0:8443 for every interface).
# DEV_SMTP_HOST: the Mailpit test server's host (port 1025).
#DEV_PUBLIC_URL=https://192.168.8.171:8443
#DEV_LISTEN=0.0.0.0:8443
#DEV_SMTP_HOST=192.168.8.112

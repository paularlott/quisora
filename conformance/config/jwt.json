{
  "alias": "quisora",
  "description": "Quisora (private_key_jwt)",
  "server": {
    "discoveryUrl": "@ISSUER@/.well-known/openid-configuration"
  },
  "client": {
    "client_id": "@CLIENTJWT_ID@",
    "jwks": @CLIENTJWT_JWKS@
  },
  "client2": {
    "client_id": "@CLIENTJWT2_ID@",
    "jwks": @CLIENTJWT2_JWKS@
  },
  "browser": [
    {
      "match": "@ISSUER@/oauth/authorize*",
      "tasks": [
        {
          "task": "Login",
          "optional": true,
          "match": "@ISSUER@/login/*",
          "commands": [
            [
              "click",
              "css",
              "a[href*='/provider/']"
            ]
          ]
        },
        {
          "task": "Verify Complete",
          "match": "*/test/*/callback*",
          "commands": [
            [
              "wait",
              "id",
              "submission_complete",
              10
            ]
          ]
        }
      ]
    },
    {
      "match": "@ISSUER@/oauth/logout*",
      "tasks": [
        {
          "task": "Confirm sign out",
          "optional": true,
          "match": "@ISSUER@/oauth/logout*",
          "commands": [
            [
              "click",
              "css",
              "form[action='/oauth/logout/confirm'] button[type=submit]",
              "optional"
            ]
          ]
        },
        {
          "task": "Verify Complete",
          "match": "*/test/*/post*"
        }
      ]
    }
  ],
  "override": {
    "oidcc-prompt-login": {
      "browser": [
        {
          "match": "@ISSUER@/oauth/authorize*",
          "tasks": [
            {
              "task": "Login",
              "optional": true,
              "match": "@ISSUER@/login/*",
              "commands": [
                [
                  "wait",
                  "xpath",
                  "//*",
                  10,
                  "Sign in",
                  "update-image-placeholder-optional"
                ],
                [
                  "click",
                  "css",
                  "a[href*='/provider/']"
                ]
              ]
            },
            {
              "task": "Verify Complete",
              "match": "*/test/*/callback*",
              "commands": [
                [
                  "wait",
                  "id",
                  "submission_complete",
                  10
                ]
              ]
            }
          ]
        }
      ]
    },

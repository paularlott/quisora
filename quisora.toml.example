# Quisora configuration. Every value has a default. Each key can also be given as a command-line flag or an QUISORA_*
# environment variable (flag > environment > this file); `quisora serve --help` lists them all.

[server]
listen = ":8443"                          # HTTPS only; there is no plain-HTTP listener
public_url = "https://id.example.com"     # the issuer; identical on every node
data_dir = "/var/lib/quisora"             # required: everything this node keeps on disk (store, mail queue, audit spool, tls)
# tls_cert = "/etc/quisora/tls.crt"           # PEM; without these a self-signed certificate is generated in data_dir/tls
# tls_key = "/etc/quisora/tls.key"
# master_key = ""                         # required: `quisora genkey`; seals secrets at rest; identical on every node of a
                                          # cluster. Better in QUISORA_MASTER_KEY from a secret store than in this file
# previous_master_keys = []               # during a master key rotation only: the old key, until the log says the rotation is complete
                                          # (docs/RUNNING.md#rotating-the-master-key)
# trust_proxy = ["10.0.0.0/8"]            # honour X-Forwarded-For only from these
# bootstrap_admin = "admin@example.com"   # email of the first super admin (the sign-in name; default admin@example.com),
                                          # created by `quisora bootstrap` with the primary organization (which
                                          # requires a second factor). The admin has no password: bootstrap prints the
                                          # invitation link to set one; `quisora invite primary admin@example.com` reissues it
# allowed_networks = []                   # private networks (CIDRs or IPs) back-channel logout / jwks_uri / upstream calls may reach, e.g. ["172.16.0.0/12"]
# allow_private_networks = false          # let them reach every private address (a home lab)
# extra_ca_file = ""                      # PEM of extra CA certificates trusted for those outbound HTTPS calls (an internal CA)
# shutdown_drain = 10                     # seconds /readyz answers 503 before stopping, when a load balancer polls it
# shutdown_timeout = 30                   # seconds requests in flight get to finish at shutdown
# restore_from = ""                       # backup file loaded at start-up when the store is empty (ignored once it has data)
# restore_password = ""                   # its password, when it is encrypted

[ui]
site_name = "Identity"
default_theme = "system"                  # light, dark or system
# logo_light = "/etc/quisora/logo.svg"        # absolute file path or https URL
# logo_dark = "/etc/quisora/logo-dark.svg"    # optional; falls back to logo_light
# skin = "corporate"                      # a built-in skin (corporate, modern), or the path of a skin folder such as ./acme (web/skins/README.md)
# footer = '© Example Ltd · <a href="mailto:help@example.com">Support</a>'  # links and <strong>, <em>, <small>, <span>, <br>

[storage]
backend = "badgerdb"                      # badgerdb, sqlite, postgres, mysql or mariadb
# [storage.badgerdb]
# sync_writes = true
# encryption_key = ""                     # `quisora genkey`: encrypt the files at rest; set when the store is created
# [storage.postgres]
# dsn = "postgres://quisora:secret@db:5432/quisora?sslmode=verify-full"
# max_open_conns = 0                      # 0 = the driver's default (also for mysql and mariadb)
# max_idle_conns = 0
# ca_file = ""                            # PEM of a private CA the server's certificate is verified against
# [storage.mysql]
# dsn = "quisora:secret@tcp(db:3306)/quisora?parseTime=true&tls=true"
# [storage.mariadb]
# dsn = "quisora:secret@tcp(db:3306)/quisora?parseTime=true"

[cluster]
# Two ways to run several nodes:
#  - share one database server (postgres, mysql, mariadb) and leave bind empty: no replication, the database
#    is the only copy, short-lived sign-in state lives there too; set [cluster.notify] so the nodes tell each other
#    of changes (caches and live pages follow at once instead of within 5 seconds);
#  - give every node its own database (any backend) and set bind: the nodes replicate to each other over gossip.
# node_id = ""                            # UUID; default: generated and kept in the data directory
# bind = "0.0.0.0:7946"                   # empty = no gossip
# advertise = "10.0.0.11:7946"
# peers = ["10.0.0.11:7946", "10.0.0.12:7946", "10.0.0.13:7946"]   # every node lists every other (required with bind)
# size = 3                                # required with bind: the number of nodes, identical on every node; the
#                                         # quorum is size/2+1 and never shrinks (scaling: docs/REPLICATION.md)
# key = ""                                # `quisora genkey`; identical on every node
# previous_keys = []                      # during a cluster key rotation only (docs/RUNNING.md#rotating-the-cluster-key)
# minority_grace = 300                    # seconds a node cut off from the majority keeps answering the token,
#                                         # userinfo and introspection endpoints (requests that need no write)
# strict_durability = false               # true: a durable write of a kind that is not quorum-committed fails when a
#                                         # majority does not confirm it; see docs/REPLICATION.md

[cluster.notify]
# Shared database only (ignored, with a warning, when cluster.bind is set): a gossip network of its own that carries
# change notices between the nodes, never data. Open its port (TCP and UDP) between the nodes only.
# bind = "0.0.0.0:7947"
# advertise = "10.0.0.11:7947"            # required when bind is a wildcard address
# peers = ["10.0.0.11:7947", "10.0.0.12:7947", "10.0.0.13:7947"]   # every node (listing itself is fine)
# key = ""                                # `quisora genkey`; identical on every node, not cluster.key

[tokens]
signing_alg = "ES256"                     # ES256 or EdDSA (RS256 is added per client when asked for)
access_ttl = 600                          # seconds
id_token_ttl = 600
refresh_ttl = 2592000                     # 30 days
code_ttl = 60
key_rotation_days = 30
api_token_max_days = 365                  # longest personal API token lifetime, days (a token made without one gets it); 0 = no limit

[session]
ttl = 604800                              # 7 days from sign-in; also the most an organization may set
idle = 86400                              # 24 hours without use (0 = no idle limit); also the most an organization may set
privileged_ttl = 43200                    # managers and above: 12 hours from sign-in (0 = as everyone)
privileged_idle = 3600                    # managers and above: 1 hour without use (0 = as everyone)
upstream_check_minutes = 60               # replay sign-in providers' refresh tokens; a refusal ends the user's sessions (0 = off)

[mail]
# smtp_host = "smtp.example.com"          # host name or IP; without it nothing is emailed (admins share invitation links)
# smtp_port = 587
# username = ""
# password = ""
# from = "Identity <no-reply@example.com>"
# tls = "starttls"                        # starttls, tls or none

[audit]
retention_days = 7                        # in the database (with gossip, on each node): development, home labs, testing. Production and SOC 2: VictoriaLogs
logins = true                             # also record successful sign-ins (failures are always recorded)
tokens = false                            # also record every refresh and client_credentials token (new grants,
                                          # revocations and token reuse are always recorded)
# victorialogs_url = "http://victorialogs:9428"   # send audit events there instead, and read the audit pages from it
# victorialogs_spool_max_mb = 256        # most disk the spool (<data_dir>/auditspool) may use; past it the oldest events go

[limits]
max_in_flight = 4096                      # concurrent requests per node before 503
login_per_ip_min = 300                    # sign-in attempts per organization and IP per minute (per account for a browser that has signed in to it before)
lockout_attempts = 10                     # failed passwords before an account is locked
lockout_minutes = 15
password_workers = 0                      # concurrent password hashes (0 = number of CPUs); waiting sign-ins are served by organization in turn
password_min_length = 15                  # shortest password accepted (8 to 64; NIST SP 800-63B: 15 where a password may be the only factor)
ephemeral_mb = 1024                       # memory per node for short-lived sign-in state (flows, codes, pushed requests); past it they get 503

[log]
level = "info"                            # trace, debug, info, warn, error
format = "console"                        # console or json
access = true                             # log every HTTP request (never its query string)

[metrics]
# token = ""                              # bearer token Prometheus sends to GET /metrics; empty = no metrics endpoint

# Secret stores: any secret setting above may name its value instead of holding it, "vault://<path>#<field>" or
# "op://<vault>/<item>/<field>" (docs/secret-stores.md). Read at start; master and cluster
# keys again on a reload (SIGHUP, or "Read secret stores now" on the system page).
# [secrets.vault]
# address = "https://vault.internal:8200"
# token_file = "/etc/quisora/vault-token"  # or token; or AppRole: role_id with secret_id or secret_id_file
# approle_mount = "approle"
# namespace = ""                          # Vault Enterprise
# ca_file = ""
# [secrets.onepassword]
# connect_url = "https://op-connect.internal:8080"
# connect_token_file = "/etc/quisora/op-connect-token"   # or connect_token
# service_account_token_file = ""         # a service account instead of Connect: the 1Password build only
# ca_file = ""
